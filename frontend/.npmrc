# vite 8 conflicts with @vitejs/plugin-react-swc's declared peer range
# (^4 || ^5 || ^6 || ^7). Allow installs to proceed with legacy peer-dependency
# resolution so `npm ci` / `npm install` succeed everywhere — local dev, the
# run-*.bat launchers, and CI builds (Cloudflare Pages) — without depending on
# an NPM_FLAGS dashboard setting. Mirrors the --legacy-peer-deps flag the
# Windows launchers pass to `npm install`.
legacy-peer-deps=true

# NMR Predict configuration
#
# Copy this file to `.env` in the same directory (project root) and edit the
# values you want to override. The backend reads `.env` automatically at
# startup via python-dotenv. Anything you don't set here falls back to the
# defaults in backend/app/config.py.
#
# After editing `.env`, restart the backend (run-nmr.bat) to pick up changes.


# =============================================================================
# ORCA (DFT NMR engine)
# =============================================================================

# Path to the ORCA executable. Leave commented to use the default
# (C:\ORCA_6.1.1\orca.exe on Windows).
#ORCA_EXE=C:\ORCA_6.1.1\orca.exe

# Number of CPU cores ORCA should use (maps to `%pal nprocs`).
# Defaults to the host CPU count. Values above the host count are clamped.
#ORCA_CPUS=8

# RAM per core in MB (maps to ORCA's `%maxcore`). Total memory used by an
# ORCA job is roughly ORCA_CPUS * ORCA_RAM_MB.
# - 2000  : cheap default, fine for small molecules
# - 4000  : recommended for medium molecules with def2-TZVP
# - 8000+ : larger basis sets (pcSseg-2, def2-TZVPP)
#ORCA_RAM_MB=2000

# DFT functional for the NMR shielding calculation.
# Common options (accuracy / cost tradeoff, roughly cheapest first):
#   PBE       - GGA. Cheapest. Default. Fine for shifts in nonpolar molecules.
#   BP86      - GGA. Similar cost to PBE.
#   TPSS      - meta-GGA. Slightly better than PBE for chemical shifts.
#   B97-D3    - GGA + dispersion. Good general-purpose choice.
#   B3LYP     - hybrid. More expensive but generally more accurate for 1H/13C.
#   PBE0      - hybrid. Similar cost/accuracy to B3LYP.
#   wB97X-D3  - range-separated hybrid. Best accuracy, most expensive.
#ORCA_FUNCTIONAL=PBE

# Basis set for the NMR calculation.
# Common options (smallest / fastest first):
#   def2-SVP     - small split-valence. Fast. Default. Qualitative only.
#   def2-TZVP    - triple-zeta. Recommended minimum for quantitative shifts.
#   def2-TZVPP   - triple-zeta + extra polarization.
#   pcSseg-1     - Jensen's NMR-optimized basis, small. Good 1H/13C accuracy.
#   pcSseg-2     - Jensen's NMR-optimized basis, medium. Best accuracy for cost.
#   pcSseg-3     - Jensen's NMR-optimized basis, large. Benchmark quality.
#   6-31G(d,p)   - legacy Pople basis, roughly def2-SVP quality.
#ORCA_BASIS=def2-SVP

# Per-job wall-clock timeout in seconds.
ORCA_TIMEOUT=600

# Where ORCA job directories and the TMS reference cache are written.
#ORCA_WORK_DIR=

# Safety ceilings (usually leave alone).
#ORCA_MAX_PENDING_REQUESTS=4
#ORCA_JOB_TTL_SECONDS=3600
#ORCA_RAM_CEILING_MB=16000


# =============================================================================
# Consensus mixing weights
# =============================================================================
# When the UI toggles the spectrum into "Mix engines" view, the backend
# combines per-engine shifts into a single weighted prediction per atom.
# Ratios are what matter — values are renormalised server-side. Engines
# that fail are dropped from the mix automatically.
#
# Defaults (phase-3 spec, tuned for general organics):
#   CDK     0.5  HOSE-code lookup. Reliable for common environments.
#   CASCADE 0.3  3D graph neural network (ML).
#   ORCA    0.2  DFT. High accuracy but expensive; lower weight hedges
#                against occasional gas-phase artefacts.
#
# Raise a weight above 1 to bias the mix toward that engine, or drop a
# weight to 0 to exclude it from consensus entirely.
#CONSENSUS_WEIGHT_CDK=0.5
#CONSENSUS_WEIGHT_CASCADE=0.3
#CONSENSUS_WEIGHT_ORCA=0.2


# =============================================================================
# CDK / CASCADE engines
# =============================================================================

# Path to the CDK jar bundle. Defaults to backend/vendor/cdk.
#CDK_JAR_PATH=

# Path to the CASCADE model assets directory (must contain preprocessor.p and
# trained_model/). Defaults to the vendored copy under backend/vendor/cascade.
#CASCADE_PATH=


# =============================================================================
# App work directory
# =============================================================================

# Where per-request scratch files live. Defaults to ./_work next to run-nmr.bat.
#NMR_WORK_DIR=


# =============================================================================
# Frontend (Vite)
# =============================================================================
# These are read by the dev server / build. Must start with `VITE_`.
# After changing, restart the frontend (npm run dev) to pick them up.

# How long the frontend waits for a /predict response before giving up (ms).
# ORCA jobs can run for minutes, so set this well above ORCA_TIMEOUT*1000.
# Default: 600000 (10 minutes).
#VITE_NMR_API_TIMEOUT_MS=600000

# Override the API base URL (default: /api via the Vite dev proxy).
#VITE_NMR_API_URL=/api

# Enable mock responses when the backend is unreachable (1 = on).
#VITE_NMR_ENABLE_DEMO_MODE=0
